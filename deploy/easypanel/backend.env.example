NODE_ENV=production
PORT=8080
APP_ORIGIN=https://app.seudominio.com
PUBLIC_APP_URL=https://app.seudominio.com

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_SERVICE_ROLE_KEY=eyJ...
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

AUTH_LOGIN_PROVIDER=auto
KEYCLOAK_ISSUER_URL=https://keycloak.seudominio.com/realms/graphflow
KEYCLOAK_CLIENT_ID=graphflow
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_ADMIN_CLIENT_ID=graphflow-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-admin-password
SUPABASE_AUTH_CALLBACK_URL=https://<project-ref>.supabase.co/auth/v1/callback

AUTH_COOKIE_NAME=graphflow_session
AUTH_REFRESH_COOKIE_NAME=graphflow_refresh
AUTH_COOKIE_DOMAIN=.seudominio.com
QUOTE_PUBLIC_TOKEN_PEPPER=replace-with-strong-random-secret-at-least-32-chars
PDF_STORAGE_BUCKET=quote-pdfs
UPLOAD_STORAGE_BUCKET=graphflow-uploads
UPLOAD_MAX_MB=25
DEV_AUTH_BYPASS=false
DEV_TENANT_ID=graphflow-main
DEV_USER_ID=dev-user
DEV_ADMIN_EMAIL=admin@email.com
