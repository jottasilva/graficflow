# Public/client-safe values
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only values. Never expose with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Optional direct database connection for server-only workers/migrations.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Keycloak / Supabase Auth provider
KEYCLOAK_ISSUER_URL=https://keycloak.example.com/realms/graphflow
KEYCLOAK_CLIENT_ID=graphflow
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_ADMIN_CLIENT_ID=graphflow-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me
# Alternativa se o cliente admin usar password grant:
# KEYCLOAK_ADMIN_USERNAME=admin
# KEYCLOAK_ADMIN_PASSWORD=change-me
SUPABASE_AUTH_CALLBACK_URL=https://<project-ref>.supabase.co/auth/v1/callback

# Backend
NODE_ENV=development
PORT=8080
APP_ORIGIN=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3000
PUBLIC_APP_URL=http://localhost:3001
AUTH_COOKIE_NAME=graphflow_session
AUTH_REFRESH_COOKIE_NAME=graphflow_refresh
# AUTH_COOKIE_DOMAIN=.seudominio.com
QUOTE_PUBLIC_TOKEN_PEPPER=replace-with-strong-random-secret
PDF_STORAGE_BUCKET=quote-pdfs
DEV_AUTH_BYPASS=true
DEV_TENANT_ID=graphflow-main
DEV_USER_ID=dev-user
